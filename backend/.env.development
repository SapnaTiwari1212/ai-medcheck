NODE_ENV=development
PORT=4000
API_PREFIX=api

# Local development defaults. Replace with real hosted credentials when available.
DATABASE_URL=postgresql://user:password@localhost:5432/ai_medcheck?sslmode=prefer
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

JWT_ACCESS_SECRET=dev-access-secret-please-change-me-1234567890
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-me-0987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CLIENT_URL=http://localhost:5173

AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=6000

OCR_PROVIDER=tesseract
OCR_MAX_PAGES=20
OCR_MAX_CHARS=60000
GOOGLE_APPLICATION_CREDENTIALS=

STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads
PUBLIC_STORAGE_BASE_URL=http://localhost:4000

EMAIL_PROVIDER=console
DEV_EMAIL_RECIPIENT=

THROTTLE_TTL=60
THROTTLE_LIMIT=100

QUEUE_CONCURRENCY=2
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF=5000

TEST_DATABASE_URL=
