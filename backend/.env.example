# ===== AI MedCheck Backend — Environment Variables =====
# Copy to .env and fill in values.

# --- Core ---
NODE_ENV=development
PORT=4000
API_PREFIX=api

# --- Database (PostgreSQL — e.g. Neon) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Redis (e.g. Upstash) ---
REDIS_URL=redis://default:password@host:port
REDIS_TLS=true

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Cookies ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- CORS ---
CLIENT_URL=http://localhost:5173

# --- AI ---
# Providers: openai | mock
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=6000

# --- OCR ---
# Providers: tesseract | google_vision
OCR_PROVIDER=tesseract
OCR_MAX_PAGES=20
OCR_MAX_CHARS=60000
# Only needed when OCR_PROVIDER=google_vision
GOOGLE_APPLICATION_CREDENTIALS=

# --- Storage ---
# Providers: local | s3 | cloudinary
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage/uploads
PUBLIC_STORAGE_BASE_URL=http://localhost:4000

# AWS S3 (STORAGE_PROVIDER=s3)
S3_REGION=us-east-1
S3_BUCKET=ai-medcheck-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Cloudinary (STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email ---
# Providers: console | ethereal | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="AI MedCheck <no-reply@aimedcheck.com>"
# Default recipient for ethereal/smtp dev deliveries
DEV_EMAIL_RECIPIENT=

# --- Security ---
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# --- BullMQ ---
QUEUE_CONCURRENCY=2
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF=5000

# --- Testing ---
# Used by e2e tests (optional)
TEST_DATABASE_URL=
